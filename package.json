{
  "name": "relayboard",
  "version": "0.4.1",
  "type": "module",
  "description": "A persistent task workspace for humans, Codex, Claude Code, pi, and their subagents.",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "relayboard": "lib/bin/relayboard.js"
  },
  "files": [
    "lib/",
    "dist/",
    "skills/",
    "integrations/README.md",
    "README.md",
    "VALIDATION.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "start": "node lib/bin/relayboard.js start",
    "dev": "tsx server/index.ts",
    "web:dev": "vite --host 127.0.0.1",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "build": "npm run build:server && npm run build:web",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json && tsc -p tsconfig.tests.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "mcp": "node lib/bin/relayboard.js mcp",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "express": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^0.468.0",
    "prettier": "^3.9.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^7.1.0"
  }
}
