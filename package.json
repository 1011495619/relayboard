{
  "name": "relayboard",
  "version": "0.2.0",
  "type": "module",
  "description": "A persistent task workspace for humans, Codex, Claude Code, pi, and their subagents.",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "relayboard": "bin/relayboard.js"
  },
  "files": [
    "bin/",
    "server/",
    "dist/",
    "skills/",
    "integrations/",
    "README.md",
    "VALIDATION.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "start": "node bin/relayboard.js start",
    "dev": "node server/index.js",
    "web:dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "check": "npm run test && npm run build",
    "mcp": "node bin/relayboard.js mcp",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "express": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^0.468.0",
    "prettier": "^3.9.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^7.1.0"
  }
}
