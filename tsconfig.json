{
  "extends": "./tsconfig.web.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "server/**/*.ts",
    "bin/**/*.ts",
    "integrations/**/*.ts",
    "web/src/**/*.ts",
    "web/src/**/*.tsx",
    "tests/**/*.ts",
    "vite.config.ts"
  ]
}
