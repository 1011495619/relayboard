{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./web/src/*"
      ]
    },
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "web/src/**/*.ts",
    "web/src/**/*.tsx",
    "vite.config.ts"
  ]
}
